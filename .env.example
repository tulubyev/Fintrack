# FinTrack — переменные окружения.
# Скопируйте в .env (chmod 600), заполните. .env в git не попадает.
# Генерация секретов:  openssl rand -hex 32

# ── Основное ────────────────────────────────────────────────
NODE_ENV=production
APP_DOMAIN=fin-wall.ru
IMAGE_TAG=latest
# PORT и каталоги данных заданы в образе (3000, /data/...) — менять не нужно
LOG_LEVEL=info
BASE_URL=https://fin-wall.ru
# CORS и ссылки в письмах (берётся первый адрес). После включения сайта (SITE_ENABLED=true):
# FRONTEND_URL=https://app.fin-wall.ru,https://fin-wall.ru
FRONTEND_URL=https://fin-wall.ru

# ── Публичный сайт (E1.8, D21) ──────────────────────────────
# true — на APP_DOMAIN публичный сайт, веб-приложение на APP_HOST; нужна DNS-запись APP_HOST → IP сервера (docs/DEPLOY.md)
SITE_ENABLED=false
APP_HOST=app.fin-wall.ru

# ── База данных (системный PostgreSQL 16 на VPS) ────────────
# Только порт 5432, хост 172.28.0.1 (шлюз сети traefik-public)
DATABASE_URL=postgresql://fintrack_user:CHANGE_ME@172.28.0.1:5432/fintrack_db
DATABASE_SSL=false
DATABASE_MAX_CONNECTIONS=10

# ── Секреты (обязательны) ───────────────────────────────────
JWT_SECRET=
JWT_REFRESH_SECRET=
SESSION_SECRET=
# Минимум 32 символа. ⚠ Смена ключа делает ранее загруженные документы нечитаемыми.
ENCRYPTION_KEY=

# ── SMS (sms.ru) — обязательно ──────────────────────────────
SMS_RU_API_KEY=
SMS_RU_SENDER=FinTrack

# ── Почта (SMTP Beget) — обязательно ────────────────────────
BEGET_SMTP_HOST=smtp.beget.com
BEGET_SMTP_PORT=465
BEGET_SMTP_USER=noreply@fin-wall.ru
BEGET_SMTP_PASSWORD=

# ── AI-ассистент (OpenRouter) — без ключа работает мок ──────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# ── Нейросеть (RouterAI, решение D2) — OpenAI-совместимый API ──
# Адрес API проверить в кабинете RouterAI. Без адреса, ключа или модели нейросеть не вызывается.
LLM_BASE_URL=https://routerai.ru/api/v1
LLM_API_KEY=
# Категоризация неузнанных мерчантов (E1.3-T8). На проде false, пока не закрыт вопрос 152-ФЗ (D2)
LLM_CATEGORIZATION_ENABLED=false
LLM_CATEGORIZATION_MODEL=
# Цена за 1000 токенов в рублях — для учёта расхода; месячный бюджет — при превышении очередь стоит, админам уведомление
LLM_PRICE_RUB_PER_1K_TOKENS=
LLM_MONTHLY_BUDGET_RUB=

# ── Push-уведомления (E2.2) — без ключей push не уходят, остаются колокольчик и письма ──
# FCM HTTP v1 (Android с сервисами Google): ключ сервисного аккаунта Firebase — JSON в одну строку или base64
FCM_SERVICE_ACCOUNT=
# RuStore Push (Android без сервисов Google, сборка rustore): RuStore Консоль → приложение → Push-уведомления → Проекты.
# ID проекта (он же — RUSTORE_PUSH_PROJECT_ID в переменных сборки приложения на GitHub) и сервисный токен
RUSTORE_PUSH_PROJECT_ID=
RUSTORE_PUSH_SERVICE_TOKEN=
# Web Push (PWA и браузеры): npx web-push generate-vapid-keys; subject — mailto: владельца
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:privacy@fin-wall.ru

# ── Мобильное приложение ────────────────────────────────────
# Вход по отпечатку или Face ID (решение D20): по умолчанию выключен — приложения не собирают биометрию.
# Супер-администратор может перекрыть значение в кабинете («Настройки приложения»).
MOBILE_BIOMETRICS_ENABLED=false
# Ссылки fin-wall.ru/app/… открываются в приложении (App Links / Universal Links). Пусто — открывается сайт.
# SHA-256 отпечатки ключа подписи APK через запятую (apksigner verify --print-certs app.apk); отладочный ключ не ставить.
ANDROID_CERT_SHA256=
# TEAMID.ru.finwall.app — когда появится сборка под iOS
APPLE_APP_ID=

# ── Госуслуги (ЕСИА) ────────────────────────────────────────
# ESIA_MOCK_MODE в production не задавать: приложение откажется стартовать.
ESIA_CLIENT_ID=
ESIA_CLIENT_SECRET=
ESIA_REDIRECT_URI=https://fin-wall.ru/api/auth/esia/callback
ESIA_ENVIRONMENT=prod
# ESIA_CERTIFICATE_PATH=
# ESIA_PRIVATE_KEY_PATH=
