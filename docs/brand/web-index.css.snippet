/* ===== FinTrack brand v0.2.0 — заменяет блоки :root, .dark и .cream в artifacts/fintrack/src/index.css =====
   Собрано из brand/tokens.json скриптом brand/scripts/build.mjs — правьте токены, а не этот файл.
   Формат тот же, что сейчас: переменная содержит готовый hsl(...), прозрачность даёт withOpacity() в tailwind.config.ts.
   Шрифт: в index.html заменить ссылку Inter на
   <link href="https://fonts.googleapis.com/css2?family=Onest:wght@400..700&display=swap" rel="stylesheet"> */

:root {
  --background: hsl(180, 12.5%, 96.9%);
  --foreground: hsl(188, 20%, 7.8%);
  --card: hsl(0, 0%, 100%);
  --card-foreground: hsl(188, 20%, 7.8%);
  --popover: hsl(0, 0%, 100%);
  --popover-foreground: hsl(188, 20%, 7.8%);
  --primary: hsl(184, 81.5%, 25.5%);
  --primary-foreground: hsl(0, 0%, 100%);
  --secondary: hsl(180, 13.3%, 94.1%);
  --secondary-foreground: hsl(192, 12.5%, 15.7%);
  --muted: hsl(180, 13.3%, 94.1%);
  --muted-foreground: hsl(188, 7.4%, 39.8%);
  --accent: hsl(180, 13.3%, 94.1%);
  --accent-foreground: hsl(188, 20%, 7.8%);
  --destructive: hsl(0, 66.4%, 46.7%);
  --destructive-foreground: hsl(0, 0%, 100%);
  --border: hsl(180, 11.5%, 89.8%);
  --input: hsl(188, 6.2%, 52.7%);
  --ring: hsl(185, 78.7%, 29.4%);
  --success: hsl(139, 61.6%, 29.6%);
  --warning: hsl(35, 100%, 30.2%);
  --chart-1: hsl(185, 78.7%, 29.4%);
  --chart-2: hsl(246, 74.3%, 63.3%);
  --chart-3: hsl(40, 100%, 36.3%);
  --chart-4: hsl(208, 61.9%, 48.4%);
  --chart-5: hsl(333, 50.6%, 51.6%);
  --sidebar: hsl(0, 0%, 100%);
  --sidebar-foreground: hsl(188, 20%, 7.8%);
  --sidebar-primary: hsl(184, 81.5%, 25.5%);
  --sidebar-primary-foreground: hsl(0, 0%, 100%);
  --sidebar-accent: hsl(180, 40%, 94.1%);
  --sidebar-accent-foreground: hsl(184, 81.8%, 21.6%);
  --sidebar-border: hsl(180, 11.5%, 89.8%);
  --sidebar-ring: hsl(185, 78.7%, 29.4%);
  /* Новые токены бренда: деньги, статусы, акцент советника. В tailwind.config.ts — см. README, шаг 1 */
  --primary-hover: hsl(184, 81.8%, 21.6%);
  --primary-subtle: hsl(180, 40%, 94.1%);
  --primary-subtle-foreground: hsl(184, 81.8%, 21.6%);
  --brand-accent: hsl(247, 64.4%, 57.1%);
  --brand-accent-foreground: hsl(0, 0%, 100%);
  --brand-accent-subtle: hsl(248, 88.2%, 96.7%);
  --income: hsl(139, 61.6%, 29.6%);
  --expense: hsl(188, 20%, 7.8%);
  --transfer: hsl(188, 7.4%, 39.8%);
  --success-subtle: hsl(138, 39.4%, 93.5%);
  --warning-solid: hsl(40, 100%, 36.3%);
  --warning-subtle: hsl(39, 87.5%, 93.7%);
  --destructive-subtle: hsl(0, 81%, 95.9%);
  --info: hsl(184, 81.5%, 25.5%);
  --info-subtle: hsl(180, 40%, 94.1%);
  --chart-6: hsl(84, 54%, 39.2%);
  --chart-7: hsl(20, 72.8%, 55.3%);
  --chart-8: hsl(188, 6.2%, 52.7%);
  --overlay: rgba(14, 19, 20, 0.45);
  --logo-top: #2A9AA2;
  --logo-base: #0A5E64;
  --font-sans: 'Onest', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  --font-serif: Georgia, serif;
  --font-mono: ui-monospace, 'JetBrains Mono', Menlo, monospace;
  --radius: 0.75rem;
  --shadow-raised: 0 1px 2px rgba(16, 23, 24, 0.06);
  --shadow-overlay: 0 8px 24px rgba(16, 23, 24, 0.12), 0 2px 6px rgba(16, 23, 24, 0.06);
  --shadow-fab: 0 6px 16px rgba(12, 111, 118, 0.32);
}

.dark {
  --background: hsl(190, 17.6%, 6.7%);
  --foreground: hsl(180, 15%, 92.2%);
  --card: hsl(188, 15.4%, 10.2%);
  --card-foreground: hsl(180, 15%, 92.2%);
  --popover: hsl(188, 15.4%, 10.2%);
  --popover-foreground: hsl(180, 15%, 92.2%);
  --primary: hsl(182, 47.5%, 57.5%);
  --primary-foreground: hsl(185, 73.9%, 9%);
  --secondary: hsl(191, 15.5%, 13.9%);
  --secondary-foreground: hsl(180, 11.5%, 89.8%);
  --muted: hsl(191, 15.5%, 13.9%);
  --muted-foreground: hsl(188, 7.5%, 60.6%);
  --accent: hsl(191, 15.5%, 13.9%);
  --accent-foreground: hsl(180, 15%, 92.2%);
  --destructive: hsl(3, 83.9%, 68.4%);
  --destructive-foreground: hsl(4, 64.7%, 10%);
  --border: hsl(189, 12.9%, 19.8%);
  --input: hsl(187, 8.2%, 40.6%);
  --ring: hsl(182, 47.5%, 57.5%);
  --success: hsl(145, 51.6%, 57.8%);
  --warning: hsl(38, 89.8%, 61.4%);
  --chart-1: hsl(182, 47.5%, 57.5%);
  --chart-2: hsl(246, 100%, 80.4%);
  --chart-3: hsl(38, 89.8%, 61.4%);
  --chart-4: hsl(209, 81.1%, 68.8%);
  --chart-5: hsl(332, 75.4%, 72.9%);
  --sidebar: hsl(188, 15.4%, 10.2%);
  --sidebar-foreground: hsl(180, 15%, 92.2%);
  --sidebar-primary: hsl(182, 47.5%, 57.5%);
  --sidebar-primary-foreground: hsl(185, 73.9%, 9%);
  --sidebar-accent: hsl(185, 72.6%, 14.3%);
  --sidebar-accent-foreground: hsl(183, 45.2%, 73.5%);
  --sidebar-border: hsl(189, 12.9%, 19.8%);
  --sidebar-ring: hsl(182, 47.5%, 57.5%);
  /* Новые токены бренда: деньги, статусы, акцент советника. В tailwind.config.ts — см. README, шаг 1 */
  --primary-hover: hsl(183, 45.2%, 73.5%);
  --primary-subtle: hsl(185, 72.6%, 14.3%);
  --primary-subtle-foreground: hsl(183, 45.2%, 73.5%);
  --brand-accent: hsl(246, 100%, 80.4%);
  --brand-accent-foreground: hsl(246, 52.6%, 14.9%);
  --brand-accent-subtle: hsl(246, 37%, 21.2%);
  --income: hsl(145, 51.6%, 57.8%);
  --expense: hsl(180, 15%, 92.2%);
  --transfer: hsl(188, 7.5%, 60.6%);
  --success-subtle: hsl(143, 45%, 15.7%);
  --warning-solid: hsl(38, 89.8%, 61.4%);
  --warning-subtle: hsl(38, 62.7%, 14.7%);
  --destructive-subtle: hsl(2, 47.6%, 16.5%);
  --info: hsl(182, 47.5%, 57.5%);
  --info-subtle: hsl(185, 72.6%, 14.3%);
  --chart-6: hsl(84, 50.5%, 61.2%);
  --chart-7: hsl(20, 87.3%, 69%);
  --chart-8: hsl(188, 7.5%, 60.6%);
  --overlay: rgba(0, 0, 0, 0.6);
  --logo-top: #5FC2C6;
  --logo-base: #CDEBEC;
}

.cream {
  --background: hsl(42, 55.6%, 92.9%);
  --foreground: hsl(34, 53.2%, 9.2%);
  --card: hsl(42, 100%, 98%);
  --card-foreground: hsl(34, 53.2%, 9.2%);
  --popover: hsl(42, 100%, 98%);
  --popover-foreground: hsl(34, 53.2%, 9.2%);
  --primary: hsl(40, 72.5%, 31.4%);
  --primary-foreground: hsl(0, 0%, 100%);
  --secondary: hsl(41, 47.5%, 88%);
  --secondary-foreground: hsl(36, 43.2%, 15.9%);
  --muted: hsl(41, 47.5%, 88%);
  --muted-foreground: hsl(36, 21.6%, 34.5%);
  --accent: hsl(41, 47.5%, 88%);
  --accent-foreground: hsl(34, 53.2%, 9.2%);
  --destructive: hsl(4, 76.5%, 40%);
  --destructive-foreground: hsl(0, 0%, 100%);
  --border: hsl(41, 40.7%, 82.2%);
  --input: hsl(38, 19.7%, 45.9%);
  --ring: hsl(41, 67.5%, 38.6%);
  --success: hsl(139, 61.6%, 29.6%);
  --warning: hsl(24, 88.4%, 33.9%);
  --chart-1: hsl(40, 62.2%, 42.5%);
  --chart-2: hsl(246, 74.3%, 63.3%);
  --chart-3: hsl(185, 78.7%, 29.4%);
  --chart-4: hsl(208, 61.9%, 48.4%);
  --chart-5: hsl(333, 50.6%, 51.6%);
  --sidebar: hsl(42, 100%, 98%);
  --sidebar-foreground: hsl(34, 53.2%, 9.2%);
  --sidebar-primary: hsl(40, 72.5%, 31.4%);
  --sidebar-primary-foreground: hsl(0, 0%, 100%);
  --sidebar-accent: hsl(42, 64.9%, 88.8%);
  --sidebar-accent-foreground: hsl(40, 78.2%, 23.3%);
  --sidebar-border: hsl(41, 40.7%, 82.2%);
  --sidebar-ring: hsl(41, 67.5%, 38.6%);
  /* Новые токены бренда: деньги, статусы, акцент советника. В tailwind.config.ts — см. README, шаг 1 */
  --primary-hover: hsl(40, 78.2%, 23.3%);
  --primary-subtle: hsl(42, 64.9%, 88.8%);
  --primary-subtle-foreground: hsl(40, 78.2%, 23.3%);
  --brand-accent: hsl(247, 64.4%, 57.1%);
  --brand-accent-foreground: hsl(0, 0%, 100%);
  --brand-accent-subtle: hsl(252, 65.2%, 95.5%);
  --income: hsl(139, 61.6%, 29.6%);
  --expense: hsl(34, 53.2%, 9.2%);
  --transfer: hsl(36, 21.6%, 34.5%);
  --success-subtle: hsl(108, 34.9%, 91.6%);
  --warning-solid: hsl(28, 85.6%, 41%);
  --warning-subtle: hsl(27, 80.5%, 92%);
  --destructive-subtle: hsl(8, 74.2%, 93.9%);
  --info: hsl(40, 72.5%, 31.4%);
  --info-subtle: hsl(42, 64.9%, 88.8%);
  --chart-6: hsl(84, 54%, 39.2%);
  --chart-7: hsl(20, 72.8%, 55.3%);
  --chart-8: hsl(35, 12.2%, 50%);
  --overlay: rgba(36, 25, 11, 0.45);
  --logo-top: #C79A32;
  --logo-base: #5C4310;
  --shadow-fab: 0 6px 16px rgba(138, 100, 22, 0.32);
}

/* Суммы: табличные цифры, чтобы столбцы сумм не «прыгали». Класс для сумм вне компонента Money. */
@layer utilities {
  .tabular { font-variant-numeric: tabular-nums; }
  .amount { font-variant-numeric: tabular-nums; font-feature-settings: "tnum" 1; white-space: nowrap; }
}
