import { useColorScheme, type TextStyle } from "react-native";

/**
 * Токены темы приложения (E2.1-T6) — бренд FinTrack v0.1.0.
 * Собрано из brand/tokens.json (brand/scripts/build.mjs); значения совпадают с темой веба (artifacts/fintrack/src/index.css).
 * Компоненты берут цвета только отсюда, а не пишут свои.
 *
 * Структура прежняя: palette.light/dark с теми же ключами, PRIMARY, space, radius, font, useColors().
 * Новые ключи палитры добавлены в конец и экраны не ломают.
 */
const palette = {
  light: {
    background: "#F6F8F8",
    foreground: "#101718",
    muted: "#5E6B6D",
    border: "#E2E8E8",
    card: "#FFFFFF",
    subtle: "#EEF2F2",
    danger: "#C62828",
    success: "#1D7A3A",
    warning: "#9A5B00",
    // новые ключи (необязательные для существующих экранов)
    primary: "#0C6F76",
    onPrimary: "#FFFFFF",
    primarySubtle: "#EAF6F6",
    link: "#0C6F76",
    accent: "#5B4BD8",
    accentSubtle: "#F1EFFE",
    income: "#1D7A3A",
    expense: "#101718",
    transfer: "#5E6B6D",
    inputBorder: "#7F8C8E",
    successSubtle: "#E8F5EC",
    warningSubtle: "#FDF3E1",
    dangerSubtle: "#FDECEC",
    overlay: "rgba(14, 19, 20, 0.45)",
  },
  dark: {
    background: "#0E1314",
    foreground: "#E8EEEE",
    muted: "#93A0A2",
    border: "#2C3739",
    card: "#161D1E",
    subtle: "#1E2729",
    danger: "#F2726B",
    success: "#5CCB8A",
    warning: "#F5B544",
    // новые ключи (необязательные для существующих экранов)
    primary: "#5FC2C6",
    onPrimary: "#062528",
    primarySubtle: "#0A3B3F",
    link: "#5FC2C6",
    accent: "#A59BFF",
    accentSubtle: "#26224A",
    income: "#5CCB8A",
    expense: "#E8EEEE",
    transfer: "#93A0A2",
    inputBorder: "#5F6E70",
    successSubtle: "#163A24",
    warningSubtle: "#3D2C0E",
    dangerSubtle: "#3E1716",
    overlay: "rgba(0, 0, 0, 0.6)",
  },
};

export type Colors = (typeof palette)["light"];

/**
 * Одна на обе темы, как раньше: фон кнопок и чипов с белым текстом (4.94:1), переключатели,
 * иконки и индикаторы на светлом (4.64:1) и тёмном (3.79:1) фоне.
 * Для текста-ссылки на тёмном фоне этого мало — используйте colors.link (9.01:1).
 */
export const PRIMARY = "#107D86";

/**
 * Шрифт Onest (OFL) — пакет @expo-google-fonts/onest, загрузка useFonts() в корневом _layout до скрытия сплэша.
 * На Android начертание задаётся семейством, а не fontWeight: с fontWeight система дорисует «ложный» жирный.
 */
export const family = {
  regular: "Onest_400Regular",
  medium: "Onest_500Medium",
  semibold: "Onest_600SemiBold",
  bold: "Onest_700Bold",
} as const;

/** Табличные цифры для сумм; вынесено в константу, чтобы `as const` не сделал массив readonly. */
const tabular: TextStyle["fontVariant"] = ["tabular-nums"];

export const space = { xs: 4, sm: 8, md: 12, lg: 16, xl: 24 } as const;
export const radius = { sm: 8, md: 12, lg: 16, pill: 999 } as const;
export const font = {
  title: { fontSize: 26, lineHeight: 32, fontFamily: family.bold, letterSpacing: -0.3 },
  heading: { fontSize: 18, lineHeight: 24, fontFamily: family.semibold },
  body: { fontSize: 16, lineHeight: 24, fontFamily: family.regular },
  caption: { fontSize: 13, lineHeight: 18, fontFamily: family.medium },
  // суммы: табличные цифры (у Onest есть tnum) — столбцы сумм выровнены
  amountHero: { fontSize: 36, lineHeight: 44, fontFamily: family.semibold, fontVariant: tabular, letterSpacing: -0.7 },
  amountLarge: { fontSize: 24, lineHeight: 32, fontFamily: family.semibold, fontVariant: tabular, letterSpacing: -0.2 },
  amount: { fontSize: 16, lineHeight: 24, fontFamily: family.medium, fontVariant: tabular },
} as const;

export function useColors(): Colors {
  return palette[useColorScheme() === "dark" ? "dark" : "light"];
}
