# ===========================================
# FinTrack Environment Configuration
# ===========================================
# Скопируйте этот файл в .env и заполните реальными значениями

# ===========================================
# ОСНОВНЫЕ НАСТРОЙКИ
# ===========================================
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# ===========================================
# БАЗА ДАННЫХ
# ===========================================
DATABASE_URL=postgresql://username:password@hostname:port/database
DATABASE_SSL=true
DATABASE_MAX_CONNECTIONS=10
DATABASE_CONNECTION_TIMEOUT=30000
DATABASE_QUERY_TIMEOUT=60000

# ===========================================
# КРИПТОГРАФИЯ И БЕЗОПАСНОСТЬ
# ===========================================
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters
JWT_REFRESH_SECRET=your-refresh-secret-key-minimum-32-characters
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SESSION_SECRET=your-session-secret-key-minimum-32-characters

# ===========================================
# RATE LIMITING НАСТРОЙКИ
# ===========================================
# General API rate limits
RATE_LIMIT_GENERAL_WINDOW_MS=900000
RATE_LIMIT_GENERAL_MAX=1000

# Authentication rate limits
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=5

# Strict API rate limits
RATE_LIMIT_STRICT_WINDOW_MS=60000
RATE_LIMIT_STRICT_MAX=30

# Moderate API rate limits
RATE_LIMIT_MODERATE_WINDOW_MS=60000
RATE_LIMIT_MODERATE_MAX=100

# File upload rate limits
RATE_LIMIT_UPLOAD_WINDOW_MS=60000
RATE_LIMIT_UPLOAD_MAX=10

# ===========================================
# НАСТРОЙКИ ЛОГИРОВАНИЯ
# ===========================================
LOG_LEVEL=info
LOG_MAX_BODY_SIZE=10240
LOG_INCLUDE_BODY=false
LOG_INCLUDE_HEADERS=false
LOG_INCLUDE_RESPONSE=false
LOG_MASK_SENSITIVE_DATA=true
LOG_SKIP_HEALTH_CHECKS=true
LOG_EXCLUDE_PATHS=/health,/metrics,/favicon.ico

# ===========================================
# ПРОИЗВОДИТЕЛЬНОСТЬ И МОНИТОРИНГ
# ===========================================
METRICS_HISTORY_SIZE=1000
METRICS_WINDOW_MS=60000
CACHE_HIT_THRESHOLD=70
SLOW_REQUEST_THRESHOLD=1000
RESPONSE_TIME_ALERT_THRESHOLD=2000
ERROR_RATE_THRESHOLD=5

# ===========================================
# CORS И БЕЗОПАСНОСТЬ HEADERS
# ===========================================
FRONTEND_URL=https://yourdomain.com,https://app.yourdomain.com
CORS_MAX_AGE=86400
CORS_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOWED_HEADERS=Origin,X-Requested-With,Content-Type,Accept,Authorization,X-API-Key,X-Request-ID
CORS_EXPOSED_HEADERS=X-Total-Count,X-Page-Count,X-Rate-Limit-Limit,X-Rate-Limit-Remaining,X-Rate-Limit-Reset

# HSTS Settings
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true

# Content Security Policy
CSP_DEFAULT_SRC='self'
CSP_STYLE_SRC='self' 'unsafe-inline' https://fonts.googleapis.com
CSP_FONT_SRC='self' https://fonts.gstatic.com
CSP_SCRIPT_SRC='self'
CSP_IMG_SRC='self' data: https:

# Session Settings
SESSION_TIMEOUT=1800000
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION=900000

# ===========================================
# ВНЕШНИЕ API СЕРВИСЫ
# ===========================================

# OpenRouter AI API
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_TIMEOUT=30000
OPENROUTER_MAX_RETRIES=3

# SMS.RU Service
SMS_RU_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
SMS_RU_TIMEOUT=10000
SMS_RU_SENDER=FinTrack

# Email Settings (Beget SMTP)
BEGET_SMTP_HOST=smtp.beget.com
BEGET_SMTP_PORT=587
BEGET_SMTP_USER=your-email@yourdomain.com
BEGET_SMTP_PASSWORD=your-smtp-password
BEGET_SMTP_SECURE=false
EMAIL_TIMEOUT=30000

# ESIA (Госуслуги) Integration
ESIA_CLIENT_ID=fintrack_production_client
ESIA_CLIENT_SECRET=your-esia-client-secret
ESIA_REDIRECT_URI=https://yourdomain.com/api/esia/callback
ESIA_SCOPE=openid fullname birthdate snils inn
ESIA_ENVIRONMENT=prod

# ===========================================
# ОБЪЕКТНОЕ ХРАНИЛИЩЕ (Object Storage)
# ===========================================
DEFAULT_OBJECT_STORAGE_BUCKET_ID=your-bucket-id
PUBLIC_OBJECT_SEARCH_PATHS=/bucket-name/public
PRIVATE_OBJECT_DIR=/bucket-name/.private

# ===========================================
# ДОПОЛНИТЕЛЬНЫЕ НАСТРОЙКИ
# ===========================================

# Static files
STATIC_PATH=/dist/public

# GitHub Integration (for backups/deployments)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Development Tools
REPLIT_DOMAINS=yourdomain.repl.co,yourapp.repl.co

# ===========================================
# DEVELOPMENT ONLY
# ===========================================
# Эти переменные используются только в development окружении
# В production они должны быть заменены на реальные значения

# DEV_OPENROUTER_API_KEY=dev_key
# DEV_SMS_RU_API_KEY=dev_key
# DEV_ESIA_CLIENT_ID=fintrack_dev_client
# DEV_EMAIL_HOST=localhost

# ===========================================
# PRODUCTION НАСТРОЙКИ
# ===========================================
# Дополнительные настройки для production окружения

# PRODUCTION_LOG_LEVEL=warn
# PRODUCTION_RATE_LIMIT_STRICT=true
# PRODUCTION_DATABASE_SSL=true
# PRODUCTION_HSTS_PRELOAD=true

# ===========================================
# ИНСТРУКЦИИ ПО НАСТРОЙКЕ
# ===========================================

# 1. ОБЯЗАТЕЛЬНЫЕ ПЕРЕМЕННЫЕ (без них приложение не запустится):
#    - DATABASE_URL
#    - JWT_SECRET  
#    - ENCRYPTION_KEY
#    - OPENROUTER_API_KEY
#    - SMS_RU_API_KEY
#    - BEGET_SMTP_HOST
#    - BEGET_SMTP_USER
#    - BEGET_SMTP_PASSWORD

# 2. РЕКОМЕНДУЕМЫЕ ДЛЯ PRODUCTION:
#    - FRONTEND_URL (для CORS)
#    - ESIA_CLIENT_ID и ESIA_CLIENT_SECRET
#    - SESSION_SECRET
#    - JWT_REFRESH_SECRET

# 3. ОПЦИОНАЛЬНЫЕ (имеют значения по умолчанию):
#    - Все настройки rate limiting
#    - Все настройки логирования
#    - Все настройки производительности
#    - Все настройки CORS headers

# 4. КАК ПОЛУЧИТЬ API КЛЮЧИ:

# OpenRouter API:
# - Перейдите на https://openrouter.ai/keys
# - Создайте новый API ключ
# - Скопируйте и вставьте в OPENROUTER_API_KEY

# SMS.RU API:
# - Зарегистрируйтесь на https://sms.ru/
# - В личном кабинете получите API ключ
# - Скопируйте и вставьте в SMS_RU_API_KEY

# ESIA (Госуслуги):
# - Подайте заявку на интеграцию с ЕСИА
# - Получите CLIENT_ID и CLIENT_SECRET
# - Настройте REDIRECT_URI в личном кабинете ЕСИА

# Beget SMTP:
# - Используйте настройки SMTP от вашего хостинг провайдера
# - Или настройте другой SMTP сервис (Gmail, Yandex, etc.)

# 5. ГЕНЕРАЦИЯ БЕЗОПАСНЫХ КЛЮЧЕЙ:
# Для генерации безопасных ключей используйте:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# или
# openssl rand -hex 32

# 6. НАСТРОЙКА DATABASE_URL:
# Формат: postgresql://username:password@hostname:port/database
# Пример: postgresql://fintrack_user:password123@localhost:5432/fintrack_db

# 7. НАСТРОЙКА FRONTEND_URL:
# Укажите все домены, с которых разрешен доступ к API
# Разделяйте запятой: https://app.domain.com,https://admin.domain.com