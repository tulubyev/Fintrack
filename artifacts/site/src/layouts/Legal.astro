---
/** Макет документа (E1.8-T6): заголовок, редакция, плашка «проект» и noindex, пока документ не вычитан юристом. */
import Base from './Base.astro';
import { LEGAL_DRAFT, LEGAL_EDITION } from '../data/legal';
import { LEGAL } from '../data/site';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const current = Astro.url.pathname;
---
<Base title={title} description={description} noindex={LEGAL_DRAFT}>
  <div class="mx-auto max-w-3xl px-4 py-14 sm:py-20">
    {LEGAL_DRAFT && (
      <p class="mb-8 rounded-[var(--radius-card)] border border-warning/40 bg-warning/10 p-4 text-sm">
        <strong>Проект документа.</strong> Текст проходит юридическую проверку и может измениться. Действующая редакция будет опубликована на этой странице.
      </p>
    )}
    <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h1>
    <p class="mt-3 text-sm text-muted-foreground">Редакция от {LEGAL_EDITION}</p>
    <div class="legal mt-8">
      <slot />
    </div>
    <nav aria-label="Другие документы" class="mt-14 border-t border-border pt-6 text-sm">
      <ul class="space-y-2">
        {LEGAL.filter((doc) => doc.href !== current).map((doc) => <li><a href={doc.href} class="text-primary hover:underline">{doc.label}</a></li>)}
      </ul>
    </nav>
  </div>
</Base>
