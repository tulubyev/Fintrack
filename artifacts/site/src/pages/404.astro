---
import Base from '../layouts/Base.astro';
import { APP_URL } from '../data/site';
---
<Base title="Страница не найдена" description="Такой страницы на сайте нет." noindex>
  <section class="mx-auto max-w-3xl px-4 py-24 text-center">
    <p class="text-sm font-medium text-primary">404</p>
    <h1 class="mt-2 text-3xl font-semibold">Такой страницы нет</h1>
    <p class="mt-3 text-muted-foreground">Возможно, ссылка устарела. Вернитесь на главную или откройте приложение.</p>
    <div class="mt-8 flex justify-center gap-3">
      <a href="/" class="rounded-lg border border-border px-5 py-3 font-medium hover:bg-muted">На главную</a>
      <a href={APP_URL} class="rounded-lg bg-primary px-5 py-3 font-medium text-primary-foreground hover:opacity-90">Открыть приложение</a>
    </div>
  </section>
</Base>
